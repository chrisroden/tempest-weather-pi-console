<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Tempest.UI.Views.AboutWindow"
        Title="About"
        Width="420"
        Height="240"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="30" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="About"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Tempest Weather Pi Console"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Version:"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="VersionText"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Installed package version from /opt/tempest/VERSION."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Content="Close"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                MinWidth="100"
                Padding="16,10"
                Background="{DynamicResource ForecastDayBackgroundBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Click="OnCloseClick"/>
    </Grid>
</Window>
