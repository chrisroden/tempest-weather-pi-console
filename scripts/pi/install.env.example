# Tempest Pi installer config example.
# Copy to install.env and keep it private.

INSTALL_MODE='both'
INSTALL_ROOT='/opt/tempest'
SERVICE_USER='pi'
BACKEND_SOURCE='/home/pi/tempest-weather-pi-console/publish/backend'
UI_SOURCE='/home/pi/tempest-weather-pi-console/publish/ui'

WEATHERFLOW_API_TOKEN='replace-with-token'
WEATHERFLOW_STATION_ID='0'
WEATHERFLOW_DEVICE_ID='0'

BACKEND_PORT='5000'
BACKEND_URL='http://localhost:5000'
HEALTH_STALE_SECONDS='15'
UI_THEME='Default'
ENABLE_AT_BOOT='yes'
