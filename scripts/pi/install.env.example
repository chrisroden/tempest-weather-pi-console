# Tempest Pi installer config example.
# Copy to install.env and keep it private.

INSTALL_MODE='both'
INSTALL_ROOT='/opt/tempest'
# Service account for systemd units (must match a real user on the Pi)
SERVICE_USER='pi'
# Local publish output when installing from a build (not used for --download-release / --update)
BACKEND_SOURCE='/path/to/repo/publish/backend'
UI_SOURCE='/path/to/repo/publish/ui'

WEATHERFLOW_API_TOKEN='replace-with-token'
WEATHERFLOW_STATION_ID='0'
WEATHERFLOW_DEVICE_ID='0'

BACKEND_PORT='5000'
BACKEND_URL='http://localhost:5000'
HEALTH_STALE_SECONDS='15'
UI_THEME='Default'
ENABLE_AT_BOOT='yes'
