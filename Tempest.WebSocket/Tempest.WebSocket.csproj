<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <!-- Server-side SignalR types (Hub, IHubContext<WeatherHub>, etc.) used by
           WeatherHub and TempestWebSocketService for broadcasting parsed weather data.
           We use FrameworkReference rather than a PackageReference to the old
           Microsoft.AspNetCore.SignalR.* 1.x packages or non-existent 10.x meta packages.
           This is the recommended approach for class libraries in .NET 8/9/10 when
           the library is only consumed by ASP.NET Core hosts. -->
      <!-- Microsoft.AspNetCore.App already brings Microsoft.Extensions.Configuration.*
           on net10.0; do not re-add those PackageReferences (NU1510). -->
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
